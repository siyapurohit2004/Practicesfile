    {
      "cell_type": "code",
      "source": [
        "total_marks = np.nansum(marks)\n",
        "print(\"1. Total Marks:\", total_marks)\n",
        "\n",
        "mean_marks = np.nanmean(marks)\n",
        "print(\"2. Average Marks:\", round(mean_marks, 2))\n",
        "\n",
        "\n",
        "median_marks = np.nanmedian(marks)\n",
        "print(\"3. Median Marks:\", median_marks)\n",
        "\n",
        "\n",
        "min_marks = np.nanmin(marks)\n",
        "print(\"4. Minimum Marks:\", min_marks)\n",
        "\n",
        "\n",
        "max_marks = np.nanmax(marks)\n",
        "print(\"5. Maximum Marks:\", max_marks)\n",
        "\n",
        "\n",
        "std_marks = np.nanstd(marks)\n",
        "print(\"6. Standard Deviation:\", round(std_marks, 2))\n",
        "\n",
        "\n",
        "var_marks = np.nanvar(marks)\n",
        "print(\"7. Variance:\", round(var_marks, 2))\n",
        "\n",
        "print(\"\\nExplanation:\")\n",
        "if std_marks < 15:\n",
        "    print(\"The standard deviation is approximately 13.20\")\n",
        "else:\n",
        "    print(\"The marks are widely spread out from the average.\")"
      ],
