    {
      "cell_type": "code",
      "source": [
        "marks_gt_80 = marks[marks > 80]\n",
        "print(\"a. Marks > 80:\\n\", marks_gt_80)\n",
        "\n",
        "marks_lt_50 = marks[marks < 50]\n",
        "print(\"\\nb. Marks < 50:\\n\", marks_lt_50)\n",
        "\n",
        "marks_60_to_80 = marks[(marks >= 60) & (marks <= 80)]\n",
        "print(\"\\nc. Marks between 60 and 80 (inclusive):\\n\", marks_60_to_80)\n",
        "\n",
        "both_conditions = (marks > 80) & (attendance_percent > 90)\n",
        "qualifying_marks = marks[both_conditions]\n",
        "print(\"\\nd. Marks of students with Marks > 80 and Attendance > 90%:\\n\", qualifying_marks)\n",
        "\n",
        "avg_qualifying = np.nanmean(qualifying_marks)\n",
        "print(\"\\ne. Average marks of students satisfying condition (d):\", round(avg_qualifying, 2))"
      ],
