    {
      "cell_type": "code",
      "source": [
        "missing_mask = np.isnan(marks)\n",
        "print(\"1. Boolean mask for missing marks:\\n\", missing_mask)\n",
        "\n",
        "\n",
        "total_missing = np.sum(missing_mask)\n",
        "print(\"\\n2. Total number of missing values:\", total_missing)\n",
        "\n",
        "\n",
        "q1 = np.nanpercentile(marks, 25)\n",
        "q2 = np.nanpercentile(marks, 50)\n",
        "q3 = np.nanpercentile(marks, 75)\n",
        "\n",
        "\n",
        "print(f\"Q1 (25th percentile): {q1}\")\n",
        "print(f\"Q2 (50th percentile / Median): {q2}\")\n",
        "print(f\"Q3 (75th percentile): {q3}\")\n",
        "\n",
        "iqr = q3 - q1\n",
        "\n",
        "print(f\"IQR (Q3 - Q1): {iqr}\")\n",
        "\n",
        "lower_bound = q1 - 1.5 * iqr\n",
        "upper_bound = q3 + 1.5 * iqr\n",
        "\n",
        "print(f\"Lower Bound: {lower_bound}\")\n",
        "print(f\"Upper Bound: {upper_bound}\")\n",
        "\n",
        "outliers = marks[(marks < lower_bound) | (marks > upper_bound)]\n",
        "\n",
        "if len(outliers) == 0:\n",
        "    print(\"Detected Outliers: None (Array is empty: [])\")\n",
        "else:\n",
        "    print(\"Detected Outliers:\", outliers)"
      ],
